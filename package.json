{
  "name": "mutabaati",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "متابعاتي — PWA عربي لمتابعة المرضى (سكر أولاً): أوفلاين، IndexedDB على الجهاز، بلا خادم",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "sw:assets": "node tools/gen-sw-assets.mjs",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0"
  }
}
